<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
        </shape>
    </item>
    <item android:top="8px" android:bottom="8px" android:left="8px" android:right="8px">
        <shape android:shape="rectangle">
            <solid android:color="#D9A441" />
            <corners
                android:topLeftRadius="18px"
                android:topRightRadius="4px"
                android:bottomLeftRadius="4px"
                android:bottomRightRadius="18px" />
        </shape>
    </item>
</layer-list>
